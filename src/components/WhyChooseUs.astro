---
// WhyChooseUs Section - Beneficios detallados de In A Pickle
---

<section id="why-us" class="section bg-cream">
  <div class="container-custom">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="section-title">
        WHY CHOOSE IN A PICKLE?
      </h2>
      <p class="section-subtitle mx-auto text-center">
        Experience the best private indoor pickleball court in North Providence
      </p>
    </div>

    <!-- Benefits Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
      
      <!-- Benefit 1: Indoor Facility -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="currentColor" viewBox="0 0 24 24">
              <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Indoor Facility
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Play year-round in our climate-controlled court. No weather interruptions, just pure pickleball fun.
        </p>
      </div>

      <!-- Benefit 2: Private Court -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Private Court
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Your game, your way. No waiting, no crowds. Complete privacy for you and your playing partners.
        </p>
      </div>

      <!-- Benefit 3: Climate Controlled -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Climate Controlled
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Comfortable temperature all year. Perfect playing conditions every single time you step on the court.
        </p>
      </div>

      <!-- Benefit 4: Local & Convenient -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Local & Convenient
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Right here in North Providence. Easy parking, simple access, and serving your local community.
        </p>
      </div>

      <!-- Benefit 5: Quality Equipment -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Quality Equipment
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Professional-grade court surface and equipment. Paddles and balls available for rent if needed.
        </p>
      </div>

      <!-- Benefit 6: Flexible Options -->
      <div class="bg-white rounded-xl p-8 shadow-soft hover:shadow-court transition-all duration-300 text-center fade-in-section">
        <div class="flex justify-center mb-4">
          <div class="w-20 h-20 rounded-full bg-primary-100 flex items-center justify-center">
            <svg class="w-10 h-10 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
        </div>
        <h3 class="text-xl font-display font-bold text-primary mb-3">
          Flexible Options
        </h3>
        <p class="text-dark-600 leading-relaxed">
          Book hourly, buy packs, or become a member. Choose the option that fits your schedule and budget.
        </p>
      </div>

    </div>

  </div>
</section>