---
// PricingCard Component - Tarjeta de precio reutilizable
interface Props {
  title: string;
  featured?: boolean;
  icon?: string;
  class?: string;
}

const { 
  title, 
  featured = false,
  icon = 'card',
  class: className = ''
} = Astro.props;

const cardClasses = featured 
  ? 'bg-white rounded-xl shadow-lg p-6 md:p-8 transition-all duration-300 hover:shadow-2xl border-4 border-accent transform hover:-translate-y-1'
  : 'bg-white rounded-xl shadow-soft p-6 md:p-8 transition-all duration-300 hover:shadow-court transform hover:-translate-y-1';
---

<div class={`${cardClasses} ${className} relative`}>
  {featured && (
    <div class="absolute -top-4 left-1/2 transform -translate-x-1/2 bg-accent text-dark px-6 py-2 rounded-full font-bold text-sm shadow-lg">
      MOST POPULAR
    </div>
  )}
  
  <!-- Icon -->
  <div class="flex justify-center mb-4">
    <div class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center">
      <svg class="w-8 h-8 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        {icon === 'clock' && (
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        )}
        {icon === 'star' && (
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
        )}
        {icon === 'package' && (
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
        )}
        {icon === 'briefcase' && (
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
        )}
        {icon === 'card' && (
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        )}
      </svg>
    </div>
  </div>

  <!-- Title -->
  <h3 class="text-2xl md:text-3xl font-display font-bold text-center text-primary mb-6">
    {title}
  </h3>

  <!-- Content Slot -->
  <div class="space-y-4">
    <slot />
  </div>
</div>