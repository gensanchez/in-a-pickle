---
// Footer Component
// Footer con información de contacto, horarios, mapa y links legales
---

<footer class="bg-primary-950 text-cream">
  <div class="container-custom py-12 md:py-16">
    
    <!-- Grid principal del footer -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      
      <!-- Columna 1: Logo y descripción -->
      <div class="lg:col-span-1">
        <div class="flex items-center space-x-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-accent flex items-center justify-center">
            <svg class="w-6 h-6 text-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <circle cx="12" cy="12" r="10" stroke-width="2"/>
              <circle cx="12" cy="12" r="2" fill="currentColor"/>
              <circle cx="8" cy="8" r="1.5" fill="currentColor"/>
              <circle cx="16" cy="8" r="1.5" fill="currentColor"/>
              <circle cx="8" cy="16" r="1.5" fill="currentColor"/>
              <circle cx="16" cy="16" r="1.5" fill="currentColor"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-lg font-display font-bold text-white leading-tight">IN A PICKLE</span>
            <span class="text-xs text-accent font-medium -mt-0.5">PICKLEBALL</span>
          </div>
        </div>
        <p class="text-cream-300 text-sm leading-relaxed">
          North Providence's only private indoor pickleball court. Play your way, on your time.
        </p>
      </div>

      <!-- Columna 2: Contacto y Dirección -->
      <div class="lg:col-span-1">
        <h3 class="text-white font-display font-bold text-lg mb-4">Visit Us</h3>
        <div class="space-y-3 text-cream-300 text-sm">
          <div class="flex items-start space-x-2">
            <svg class="w-5 h-5 text-accent flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <div>
              <p class="font-medium text-white">1234 Example St</p>
              <p>North Providence, RI 02911</p>
            </div>
          </div>
          
          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+14015551234" class="hover:text-white transition-colors">(401) 555-1234</a>
          </div>

          <div class="flex items-center space-x-2">
            <svg class="w-5 h-5 text-accent flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:info@inapickle.com" class="hover:text-white transition-colors">info@inapickle.com</a>
          </div>
        </div>
      </div>

      <!-- Columna 3: Horarios -->
      <div class="lg:col-span-1">
        <h3 class="text-white font-display font-bold text-lg mb-4">Hours</h3>
        <div class="space-y-2 text-cream-300 text-sm">
          <div class="flex justify-between items-center">
            <span class="font-medium text-white">Monday - Friday</span>
            <span>8 AM - 7 PM</span>
          </div>
          <div class="flex justify-between items-center">
            <span class="font-medium text-white">Saturday - Sunday</span>
            <span>8 AM - 4 PM</span>
          </div>
          <div class="pt-2 mt-2 border-t border-primary-800">
            <p class="text-xs text-cream-400">
              <span class="text-accent font-semibold">Walk-ins welcome</span> or book ahead for guaranteed court time
            </p>
          </div>
        </div>
      </div>

      <!-- Columna 4: Mapa (placeholder) -->
      <div class="lg:col-span-1">
        <h3 class="text-white font-display font-bold text-lg mb-4">Location</h3>
        <a 
          href="https://maps.google.com/?q=1234+Example+St+North+Providence+RI" 
          target="_blank" 
          rel="noopener noreferrer"
          class="block group"
        >
          <div class="bg-primary-900 rounded-lg overflow-hidden h-32 border-2 border-primary-800 group-hover:border-accent transition-colors">
            <div class="w-full h-full flex items-center justify-center">
              <svg class="w-12 h-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
          </div>
          <p class="text-accent text-sm mt-2 group-hover:underline">View on Google Maps →</p>
        </a>
      </div>
    </div>

    <!-- Divider -->
    <div class="border-t border-primary-800 my-8"></div>

    <!-- Footer bottom: Links legales y Copyright -->
    <div class="flex flex-col md:flex-row justify-between items-center space-y-4 md:space-y-0">
      
      <!-- Copyright -->
      <p class="text-cream-400 text-sm">
        © {new Date().getFullYear()} In A Pickle Pickleball. All rights reserved.
      </p>

      <!-- Links legales -->
      <div class="flex items-center space-x-6 text-cream-400 text-sm">
        <a href="/privacy" class="hover:text-white transition-colors">Privacy Policy</a>
        <a href="/terms" class="hover:text-white transition-colors">Terms of Service</a>
        <a href="/waiver" class="hover:text-white transition-colors">Liability Waiver</a>
      </div>

      <!-- Social Media (opcional) -->
      <div class="flex items-center space-x-4">
        <!-- <a 
          href="https://facebook.com/inapickle" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-cream-400 hover:text-accent transition-colors"
          aria-label="Facebook"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        </a> -->
        <a 
          href="https://www.instagram.com/inapickleri" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-cream-400 hover:text-accent transition-colors"
          aria-label="Instagram"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>