---
// HomeFeatures Component - Mini resumen de beneficios para la home page
---

<section class="section bg-white">
    <div class="container-custom">
        <!-- Section Header -->
        <div class="text-center mb-12">
            <h2
                class="text-3xl md:text-4xl font-display font-bold text-primary mb-4"
            >
                Why Choose In A Pickle?
            </h2>
            <p class="text-lg text-dark-600 max-w-2xl mx-auto">
                North Providence's only private indoor pickleball court
            </p>
        </div>

        <!-- Features Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-5xl mx-auto">
            <!-- Feature 1 -->
            <div
                class="bg-cream rounded-xl p-6 text-center hover:shadow-lg transition-all duration-300"
            >
                <div class="flex justify-center mb-4">
                    <div
                        class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center"
                    >
                        <svg
                            class="w-8 h-8 text-primary"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
                            ></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-xl font-display font-bold text-primary mb-3">
                    Indoor & Climate Controlled
                </h3>
                <p class="text-dark-600 mb-4">
                    Play year-round in perfect conditions. No weather
                    interruptions, ever.
                </p>
                <a
                    href="/why-us"
                    class="text-primary font-semibold hover:underline"
                >
                    Learn more →
                </a>
            </div>

            <!-- Feature 2 -->
            <div
                class="bg-cream rounded-xl p-6 text-center hover:shadow-lg transition-all duration-300"
            >
                <div class="flex justify-center mb-4">
                    <div
                        class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center"
                    >
                        <svg
                            class="w-8 h-8 text-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                            ></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-xl font-display font-bold text-primary mb-3">
                    Private Court
                </h3>
                <p class="text-dark-600 mb-4">
                    Your game, your way. No waiting, no crowds, complete
                    privacy.
                </p>
                <a
                    href="/why-us"
                    class="text-primary font-semibold hover:underline"
                >
                    Learn more →
                </a>
            </div>

            <!-- Feature 3 -->
            <div
                class="bg-cream rounded-xl p-6 text-center hover:shadow-lg transition-all duration-300"
            >
                <div class="flex justify-center mb-4">
                    <div
                        class="w-16 h-16 rounded-full bg-primary-100 flex items-center justify-center"
                    >
                        <svg
                            class="w-8 h-8 text-primary"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                            ></path>
                        </svg>
                    </div>
                </div>
                <h3 class="text-xl font-display font-bold text-primary mb-3">
                    Flexible Options
                </h3>
                <p class="text-dark-600 mb-4">
                    Book hourly, buy packs, or become a member. Choose what fits
                    you.
                </p>
                <a
                    href="/pricing"
                    class="text-primary font-semibold hover:underline"
                >
                    See pricing →
                </a>
            </div>
        </div>

        <!-- CTA Footer -->
        <div class="text-center mt-12">
            <p class="text-dark-600 mb-6">
                Ready to experience the difference?
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
                <a
                    href="https://example.com/book"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="btn-primary"
                >
                    Book a Court
                </a>
                <a href="/pricing" class="btn-secondary"> View All Options </a>
            </div>
        </div>
    </div>
</section>