---
// Pricing Section - Grid de opciones de precios
import PricingCard from './PricingCard.astro';
import Button from './Button.astro';
---

<section id="pricing" class="section bg-white">
  <div class="container-custom">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="section-title">
        PRICING
      </h2>
      <p class="section-subtitle mx-auto text-center">
        Choose the plan that works for you
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 mb-16">
      
      <!-- Card 1: Hourly Play -->
      <PricingCard title="HOURLY PLAY" icon="clock">
        <div class="text-center space-y-3">
          <div class="border-b border-primary-100 pb-3">
            <p class="text-sm text-dark-600 font-semibold">Non-Member Weekdays</p>
            <p class="text-3xl font-bold text-primary">$60<span class="text-lg text-dark-500">/hr</span></p>
          </div>
          
          <div class="border-b border-primary-100 pb-3">
            <p class="text-sm text-dark-600 font-semibold">Non-Member Weekends</p>
            <p class="text-3xl font-bold text-primary">$65<span class="text-lg text-dark-500">/hr</span></p>
          </div>
          
          <div class="border-b border-primary-100 pb-3">
            <p class="text-sm text-dark-600 font-semibold">Standard Member</p>
            <p class="text-3xl font-bold text-secondary-900">$50<span class="text-lg text-dark-500">/hr</span></p>
          </div>
          
          <div class="pb-2">
            <p class="text-sm text-dark-600 font-semibold">Premium Member</p>
            <p class="text-3xl font-bold text-accent">$45<span class="text-lg text-dark-500">/hr</span></p>
          </div>
        </div>
        
        <div class="mt-6">
          <Button 
            href="https://example.com/book-hourly" 
            variant="primary"
            size="md"
            external={true}
            class="w-full"
          >
            Book Hourly
          </Button>
        </div>
      </PricingCard>

      <!-- Card 2: Memberships -->
      <PricingCard title="MEMBERSHIPS" icon="star" featured={true}>
        <div class="text-center">
          <p class="text-sm text-dark-600 mb-4">2 × 60-minute sessions per week</p>
          
          <div class="space-y-4">
            <div class="bg-cream-100 rounded-lg p-4">
              <p class="text-lg font-bold text-dark mb-1">Standard</p>
              <p class="text-4xl font-bold text-primary">$99</p>
              <p class="text-sm text-dark-500">per year</p>
            </div>
            
            <div class="bg-accent-50 rounded-lg p-4 border-2 border-accent">
              <p class="text-lg font-bold text-dark mb-1">Premium</p>
              <p class="text-4xl font-bold text-accent">$199</p>
              <p class="text-sm text-dark-500">per year</p>
            </div>
          </div>
        </div>
        
        <div class="mt-6">
          <Button 
            href="#memberships" 
            variant="accent"
            size="md"
            class="w-full"
          >
            Become a Member
          </Button>
        </div>
      </PricingCard>

      <!-- Card 3: Packs -->
      <PricingCard title="PACKS" icon="package">
        <div class="text-center space-y-3">
          <div class="border-b border-primary-100 pb-3">
            <p class="text-lg font-semibold text-dark mb-1">5-Pack</p>
            <p class="text-3xl font-bold text-primary">$275</p>
            <p class="text-xs text-dark-500">$55 per session</p>
          </div>
          
          <div class="border-b border-primary-100 pb-3">
            <p class="text-lg font-semibold text-dark mb-1">10-Pack</p>
            <p class="text-3xl font-bold text-primary">$520</p>
            <p class="text-xs text-dark-500">$52 per session</p>
          </div>
          
          <div class="pb-2">
            <p class="text-lg font-semibold text-dark mb-1">15-Pack</p>
            <p class="text-3xl font-bold text-primary">$750</p>
            <p class="text-xs text-dark-500">$50 per session</p>
          </div>
        </div>
        
        <div class="mt-6">
          <Button 
            href="https://example.com/buy-pack" 
            variant="primary"
            size="md"
            external={true}
            class="w-full"
          >
            Buy a Pack
          </Button>
        </div>
      </PricingCard>

      <!-- Card 4: Corporate -->
      <PricingCard title="CORPORATE" icon="briefcase">
        <div class="text-center">
          <p class="text-sm text-dark-600 mb-4">Yearly Corporate Membership</p>
          
          <div class="space-y-3">
            <div class="bg-amber-50 rounded-lg p-3 border border-amber-200">
              <p class="text-base font-bold text-dark">Bronze</p>
              <p class="text-2xl font-bold text-amber-600">$999</p>
            </div>
            
            <div class="bg-gray-50 rounded-lg p-3 border border-gray-300">
              <p class="text-base font-bold text-dark">Silver</p>
              <p class="text-2xl font-bold text-gray-600">$1,899</p>
            </div>
            
            <div class="bg-accent-50 rounded-lg p-3 border-2 border-accent">
              <p class="text-base font-bold text-dark">Gold</p>
              <p class="text-2xl font-bold text-accent">$3,999</p>
            </div>
          </div>
        </div>
        
        <div class="mt-6">
          <Button 
            href="https://example.com/corporate" 
            variant="secondary"
            size="md"
            external={true}
            class="w-full"
          >
            Partner with Us
          </Button>
        </div>
      </PricingCard>

    </div>

    <!-- Add-ons Section -->
    <div class="max-w-3xl mx-auto text-center bg-cream rounded-xl p-8 shadow-soft">
      <h3 class="text-2xl font-display font-bold text-dark mb-4">ADD-ONS</h3>
      <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
        <div class="flex items-center space-x-2">
          <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="text-dark-700 font-semibold">Save My Play</span>
        </div>
        <div class="flex items-center space-x-2">
          <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          <span class="text-dark-700 font-semibold">Equipment Rentals</span>
        </div>
      </div>
      <p class="text-sm text-dark-500 mt-4">Available for all membership types and hourly bookings</p>
    </div>

  </div>
</section>