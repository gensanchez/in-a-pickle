---
// LocationInfo Section - Ubicación, horarios y contacto
---

<section id="location" class="section bg-white">
  <div class="container-custom">
    
    <!-- Section Header -->
    <div class="text-center mb-12 md:mb-16">
      <h2 class="section-title">
        VISIT IN A PICKLE
      </h2>
      <p class="section-subtitle mx-auto text-center">
        Find us in North Providence - We're easy to reach
      </p>
    </div>

    <!-- Location Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 max-w-5xl mx-auto">
      
      <!-- Left Column: Map -->
      <div class="fade-in-section">
        <div class="bg-cream rounded-xl overflow-hidden shadow-soft h-full min-h-[300px] lg:min-h-[400px]">
          <a 
            href="https://maps.google.com/?q=1234+Example+St+North+Providence+RI" 
            target="_blank" 
            rel="noopener noreferrer"
            class="block w-full h-full group"
          >
            <div class="w-full h-full flex flex-col items-center justify-center p-8 hover:bg-cream-200 transition-colors">
              <svg class="w-24 h-24 text-primary mb-4 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
              <p class="text-primary font-bold text-lg group-hover:underline">
                Open in Google Maps →
              </p>
              <p class="text-dark-600 text-sm mt-2">
                Click to get directions
              </p>
            </div>
          </a>
        </div>
      </div>

      <!-- Right Column: Info -->
      <div class="space-y-8 fade-in-section">
        
        <!-- Address -->
        <div>
          <h3 class="text-2xl font-display font-bold text-primary mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Address
          </h3>
          <p class="text-lg text-dark-700 leading-relaxed">
            1234 Example St<br/>
            North Providence, RI 02911
          </p>
        </div>

        <!-- Hours -->
        <div>
          <h3 class="text-2xl font-display font-bold text-primary mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            Hours
          </h3>
          <div class="space-y-2 text-dark-700">
            <div class="flex justify-between items-center bg-cream px-4 py-3 rounded-lg">
              <span class="font-semibold">Monday - Friday</span>
              <span>8:00 AM - 7:00 PM</span>
            </div>
            <div class="flex justify-between items-center bg-cream px-4 py-3 rounded-lg">
              <span class="font-semibold">Saturday - Sunday</span>
              <span>8:00 AM - 4:00 PM</span>
            </div>
          </div>
          <p class="text-sm text-accent font-semibold mt-3 flex items-center">
            <svg class="w-5 h-5 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
            Walk-ins welcome or book ahead!
          </p>
        </div>

        <!-- Contact -->
        <div>
          <h3 class="text-2xl font-display font-bold text-primary mb-4 flex items-center">
            <svg class="w-6 h-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            Contact
          </h3>
          <div class="space-y-3">
            <a href="tel:+14015551234" class="flex items-center text-lg text-dark-700 hover:text-primary transition-colors">
              <svg class="w-5 h-5 mr-2 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
              (401) 555-1234
            </a>
            <a href="mailto:info@inapickle.com" class="flex items-center text-lg text-dark-700 hover:text-primary transition-colors">
              <svg class="w-5 h-5 mr-2 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              info@inapickle.com
            </a>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>